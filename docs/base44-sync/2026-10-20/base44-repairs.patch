+        for(const [key,value] of Object.entries(operations.$inc || {})) row[key]=(row[key] || 0)+value;
+        for(const [key,value] of Object.entries(operations.$addToSet || {})) { row[key] ||= []; if(!row[key].includes(value))row[key].push(value); }
+      }
