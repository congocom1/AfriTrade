+function fixture() {
+  const data = {
+    Product: [{id:'p1',title:'Product',stock:10,price_usd:10,supplier_price:4,status:'published',source_type:'local_seller',seller_id:'s1',seller_name:'Seller'}],
+    Seller: [{id:'s1',name:'Seller',email:'seller@example.com'}],
+    DeliveryZone: [{id:'d1',city:'Kinshasa',active:true,fee_usd:4}],
+    PlatformSetting: [], Coupon: [], Creator: [], PickupPoint: [],
+    CommerceControl: [{id:'6ad6b6758f2fd61c242969e0',key:'commerce-global-v1',state:'idle',owner:'',dirty:false}],
+    Order: [], FulfillmentOrder: [], Wallet: [], WalletTransaction: [], WalletWithdrawalRequest: [], Base44Purchase: [],
+  };
+  const writes = [];
+  let failEntity = '';
+  function matches(row, query) {
+    return Object.entries(query).every(([key, value]) => {
+      const actual = row[key];
+      if (value && typeof value === 'object' && !Array.isArray(value)) return Object.entries(value).every(([op, operand]) => {
+        if (op === '$gte') return actual >= operand;
+        if (op === '$lte') return actual <= operand;
+        if (op === '$ne') return Array.isArray(actual) ? !actual.includes(operand) : actual !== operand;
+        if (op === '$in') return operand.includes(actual);
+        throw Error('Unsupported query ' + op);
+      });
+      return value === null ? actual == null : (Array.isArray(actual) ? actual.includes(value) : actual === value);
+    });
