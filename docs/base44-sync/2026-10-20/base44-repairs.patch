+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import ts from 'typescript';
+import { parseStoredCart, normalizeCartQuantity } from '../src/lib/cartStorage.js';
+
+async function loadTs(path) {
+  const source = await fs.readFile(new URL(path, import.meta.url), 'utf8');
+  const { outputText } = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.ESNext, target: ts.ScriptTarget.ES2022 } });
+  return import('data:text/javascript;base64,' + Buffer.from(outputText).toString('base64'));
+}
+const { recomputeOrderTotals } = await loadTs('../base44/shared/orderPricing.ts');
+const { ledgerBalance } = await loadTs('../base44/shared/ledger.ts');
+
+function fixture({ product = {}, coupon = null, fee = 4, threshold = 60, products = null, fail = false } = {}) {
+  const catalogue = products || { p1: { id: 'p1', status: 'published', stock: 20, price_usd: 10, seller_id: 'seller-a', ...product } };
+  const db = { asServiceRole: { entities: {
+    Product: { get: async (id) => { if (fail) throw Error('catalogue unavailable'); return catalogue[id]; } },
+    Coupon: { filter: async () => coupon ? [coupon] : [] },
+    PlatformSetting: { filter: async () => [{ value: { free_shipping_threshold_usd: threshold } }] },
+    DeliveryZone: { filter: async ({ city }) => city === 'Kinshasa' ? [{ city, active: true, fee_usd: fee }] : [] },
+    PickupPoint: { get: async (id) => id === 'pickup' ? { id, active: true, fee_usd: 0.5 } : null },
+  } } };
+  const order = { items: [{ product_id: 'p1', quantity: 2 }], city: 'Kinshasa', delivery_method: 'home_delivery', shipping_usd: 0 };
+  return { db, order };
+}
+
+test('malformed or non-array stored carts cannot crash rendering', () => {
+  for (const raw of ['{', '{}', 'null', '42', '"string"']) assert.deepEqual(parseStoredCart(raw), []);
+});
+test('stored cart quantities and prices are normalized', () => {
+  const rows = parseStoredCart(JSON.stringify([{product_id:'p1',quantity:'2',price_usd:'3.50'},null,{product_id:'p2',quantity:-1}]));
+  assert.equal(rows.length,1); assert.equal(rows[0].quantity,2); assert.equal(rows[0].price_usd,3.5);
+});
+test('invalid, fractional and excessive cart quantities are bounded', () => {
+  for (const value of [NaN, Infinity, -1, 0, 1.5, 'bad']) assert.equal(normalizeCartQuantity(value),0);
+  assert.equal(normalizeCartQuantity(10000),999);
+});
+test('catalogue prices and delivery fees override browser amounts', async () => {
+  const {db,order}=fixture(); order.total_usd=0.01;order.items[0].unit_price_usd=0.01;
+  const result=await recomputeOrderTotals(db,order);
+  assert.equal(result.ok,true);assert.equal(result.subtotal,20);assert.equal(result.shipping,4);assert.equal(result.total,24);
+});
+test('a missing product rejects the whole basket', async () => {
+  const {db,order}=fixture();order.items.push({product_id:'missing',quantity:1});
+  assert.equal((await recomputeOrderTotals(db,order)).ok,false);
+});
+test('catalogue outages fail closed', async () => {
+  const {db,order}=fixture({fail:true});await assert.rejects(recomputeOrderTotals(db,order),/catalogue unavailable/);
+});
+for (const quantity of [0,-1,1.5,'bad',Infinity,1000]) test('invalid quantity '+quantity+' is rejected',async()=>{
+  const {db,order}=fixture();order.items[0].quantity=quantity;assert.equal((await recomputeOrderTotals(db,order)).ok,false);
+});
+test('duplicate product lines cannot bypass available stock',async()=>{
+  const {db,order}=fixture({product:{stock:3}});order.items.push({product_id:'p1',quantity:2});
+  assert.equal((await recomputeOrderTotals(db,order)).ok,false);
+});
+test('unpublished products cannot be purchased',async()=>{
+  const {db,order}=fixture({product:{status:'draft'}});assert.equal((await recomputeOrderTotals(db,order)).ok,false);
+});
+test('negative and non-finite catalogue prices are rejected',async()=>{
+  for(const price_usd of [-1,Infinity,'invalid']){const {db,order}=fixture({product:{price_usd}});assert.equal((await recomputeOrderTotals(db,order)).ok,false);}
+});
+test('coupon minimum spend is enforced on the server',async()=>{
+  const {db,order}=fixture({coupon:{type:'fixed',value:10,min_order_usd:50}});order.coupon_code='SAVE';
+  assert.equal((await recomputeOrderTotals(db,order)).ok,false);
+});
+test('expired coupons fail validation',async()=>{
+  const {db,order}=fixture({coupon:{type:'fixed',value:1,expires_at:'2000-01-01'}});order.coupon_code='SAVE';
+  assert.equal((await recomputeOrderTotals(db,order)).ok,false);
+});
+test('seller coupons cannot discount another seller',async()=>{
+  const {db,order}=fixture({coupon:{type:'fixed',value:10,seller_id:'seller-b'}});order.coupon_code='SAVE';
+  assert.equal((await recomputeOrderTotals(db,order)).ok,false);
+});
+test('discounts are capped to the basket amount',async()=>{
+  const {db,order}=fixture({coupon:{type:'fixed',value:100}});order.coupon_code='SAVE';
+  const r=await recomputeOrderTotals(db,order);assert.equal(r.discount,20);assert.equal(r.total,4);
+});
+test('percentage discounts obey their maximum',async()=>{
+  const {db,order}=fixture({coupon:{type:'percent',value:50,max_discount_usd:3}});order.coupon_code='SAVE';
+  const r=await recomputeOrderTotals(db,order);assert.equal(r.discount,3);assert.equal(r.total,21);
+});
+test('free shipping uses post-discount subtotal',async()=>{
+  const {db,order}=fixture({product:{price_usd:35},coupon:{type:'fixed',value:20}});order.coupon_code='SAVE';
+  const r=await recomputeOrderTotals(db,order);assert.equal(r.free_shipping,false);assert.equal(r.shipping,4);
+});
+test('a zero threshold disables automatic free shipping',async()=>{
+  const {db,order}=fixture({threshold:0});assert.equal((await recomputeOrderTotals(db,order)).shipping,4);
+});
+test('unsupported destinations are rejected even for free shipping',async()=>{
+  const {db,order}=fixture({product:{price_usd:100}});order.city='Unserved';
+  assert.equal((await recomputeOrderTotals(db,order)).ok,false);
+});
+test('pickup fee is read from the selected point',async()=>{
+  const {db,order}=fixture();order.delivery_method='pickup_point';order.pickup_point_id='pickup';
+  assert.equal((await recomputeOrderTotals(db,order)).shipping,0.5);
+});
+test('cent arithmetic preserves exact small totals',async()=>{
+  const {db,order}=fixture({product:{price_usd:0.1},fee:0.2});order.items[0].quantity=3;
+  assert.equal((await recomputeOrderTotals(db,order)).total,0.5);
+});
+
+function ledger(rows, calls=[]) {return {asServiceRole:{entities:{WalletTransaction:{filter:async(q,sort,limit,skip)=>{calls.push(skip);return rows.slice(skip,skip+limit);}}}}};}
+const tx=(id,direction,amount_usd,status='posted')=>({id,direction,amount_usd,status});
+test('pending credits are excluded and pending withdrawals reserve funds',async()=>{
+  const r=await ledgerBalance(ledger([tx('1','credit',100),tx('2','credit',1000,'pending'),tx('3','debit',20,'pending'),tx('4','debit',5),tx('5','credit',99,'reversed')]),'wallet');
+  assert.deepEqual(r,{balance:75,credits:100,debits:25});
+});
+test('balances include more than 500 transactions',async()=>{
+  const calls=[];const rows=Array.from({length:1001},(_,i)=>tx(String(i),'credit',0.01));
+  const r=await ledgerBalance(ledger(rows,calls),'wallet');assert.equal(r.balance,10.01);assert.deepEqual(calls,[0,500,1000]);
+});
+test('ledger read errors cannot become zero balances',async()=>{
+  await assert.rejects(ledgerBalance({asServiceRole:{entities:{WalletTransaction:{filter:async()=>{throw Error('read failed');}}}}},'wallet'),/read failed/);
+});
+test('invalid ledger amounts and directions stop debit decisions',async()=>{
+  for(const row of [tx('1','credit',-1),tx('1','credit',Infinity),tx('1','unknown',1),tx('1','credit',1,'unknown')])
+    await assert.rejects(ledgerBalance(ledger([row]),'wallet'));
+});
+test('repeated ledger pages are detected',async()=>{
+  await assert.rejects(ledgerBalance(ledger([tx('1','credit',1),tx('1','credit',1)]),'wallet'),/pagination/);
+});
+
+// Hosted checkout runs after the existing order flow reserves inventory.
+test('card repricing accepts already-reserved inventory without trusting browser prices', async () => {
+  const { db, order } = fixture({ product: { stock: 0 } });
+  const result = await recomputeOrderTotals(db, order, { checkStock: false });
+  assert.equal(result.ok, true);
+  assert.equal(result.subtotal, 20);
+  assert.equal((await recomputeOrderTotals(db, order)).ok, false);
+});
