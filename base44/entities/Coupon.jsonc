{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "tenant_owner_email": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed",
        "free_shipping"
      ],
      "default": "percent"
    },
    "value": {
      "type": "number",
      "default": 0
    },
    "min_order_usd": {
      "type": "number",
      "default": 0
    },
    "max_discount_usd": {
      "type": "number",
      "default": 0
    },
    "usage_limit": {
      "type": "number",
      "default": 0
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "expires_at": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.active": true
        },
        {
          "data.tenant_owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}