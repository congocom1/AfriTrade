+// A per-order random bearer credential; it is never put into URLs or analytics.
+export function getCheckoutRequest(payload) {
+  const fingerprint = JSON.stringify(payload);
+  const existing = read('checkout_request', null);
+  if (existing?.fingerprint === fingerprint && existing?.token && existing?.id) return existing;
+  const token = [...crypto.getRandomValues(new Uint8Array(32))].map(x => x.toString(16).padStart(2, '0')).join('');
+  const request = { fingerprint, id: crypto.randomUUID(), token };
+  write('checkout_request', request);
+  return request;
+}
+export function rememberOrderAccess(number, token) {
+  const access = read('order_access', {});
+  access[number] = token;
+  write('order_access', access);
+}
+export function getOrderAccess(number) { return read('order_access', {})[number] || ''; }
+export function finishCheckoutRequest() { write('checkout_request', null); }
