@@ -0,0 +1,38 @@
+import { withCommerceLock } from './commerceLock.ts';
+import { issueInvoiceNumber } from './invoiceSequence.ts';
+export async function settleCardOrder(db, purchase, reference) {
+  return withCommerceLock({ asServiceRole: db }, 'settle-card', gate => settleLockedCardOrder(db, purchase, reference, gate));
+}
+async function settleLockedCardOrder(db, purchase, reference, gate) {
+  const rows = await db.entities.Order.filter({ order_number: purchase.productId }, 'created_date', 2);
+  if (rows.length !== 1) throw new Error('Paid purchase must resolve to exactly one order');
+  const order = rows[0];
+  const amount = Number(purchase.amount);
+  if (!order.server_priced || !order.checkout_ready || order.is_demo ||
+      order.payment_provider !== 'card' || purchase.currency !== 'USD' ||
+      !Number.isFinite(amount) || amount <= 0 || Math.round(amount * 100) !== Math.round(Number(order.total_usd) * 100))
+    throw new Error('Payment does not match a server-priced order');
+  if (!['PENDING','PAID'].includes(order.payment_status) || order.status === 'CANCELLED')
+    throw new Error('Payment requires manual reconciliation');
+  if (order.payment_status === 'PAID' && order.payment_reference !== reference)
+    throw new Error('A different payment already settled this order');
+  // Only existing records are updated: retries cannot create duplicate fulfillments or ledger credits.
+  const fulfillments = await db.entities.FulfillmentOrder.filter({ order_id: order.id }, 'fulfillment_number', 100);
+  if (fulfillments.length !== order.fulfillment_count) throw new Error('Incomplete fulfillment plan');
+  await gate.markDirty();
+  const invoiceNumber = await issueInvoiceNumber(db.entities, order);
+  if (order.payment_status === 'PENDING') {
+    const claimed = await db.entities.Order.updateMany({ id: order.id, payment_status: 'PENDING', status: { $ne: 'CANCELLED' } }, {
+      $set: { invoice_number: invoiceNumber, payment_status: 'PAID', payment_verified: true, payment_reference: reference,
+        status: order.status === 'PENDING' ? 'CONFIRMED' : order.status },
+    });
+    if (claimed.updated !== 1) {
+      const current = await db.entities.Order.get(order.id);
+      if (current?.payment_status !== 'PAID' || current?.payment_reference !== reference) throw new Error('Payment settlement conflict');
+    }
+  }
+  if (order.payment_status === 'PAID' && !order.invoice_number) await db.entities.Order.update(order.id, { invoice_number: invoiceNumber });
+  for (const row of fulfillments) {
+    if (row.status === 'PENDING') await db.entities.FulfillmentOrder.updateMany({ id: row.id, status: 'PENDING' }, { $set: { status: 'CONFIRMED' } });
+  }
+}
