@@ -0,0 +1,23 @@
+import { createClientFromRequest } from 'npm:@base44/sdk@0.8.49';
+import { mayReadOrder, publicOrder, publicFulfillment } from '../../shared/checkoutService.ts';
+
+export default async function(req) {
+  if (req.method !== 'POST') return Response.json({ error: 'Méthode interdite' }, { status: 405 });
+  try {
+    const base44 = createClientFromRequest(req);
+    const user = await base44.auth.me().catch(() => null);
+    const body = await req.json();
+    const number = String(body.order_number || '').slice(0, 100);
+    const order = (await base44.asServiceRole.entities.Order.filter({ order_number: number }, 'created_date', 1))[0];
+    if (!(await mayReadOrder(order, user, body.access_token)))
+      return Response.json({ error: 'Commande introuvable' }, { status: 404 });
+    const rows = await base44.asServiceRole.entities.FulfillmentOrder.filter({ order_id: order.id }, 'fulfillment_number', 100);
+    const shipments = await base44.asServiceRole.entities.Shipment.filter({ order_number: order.order_number }, '-created_date', 100);
+    return Response.json({ order: publicOrder(order), fulfillments: rows.map(publicFulfillment),
+      shipments: shipments.map(row => ({ id: row.id, status: row.status, courier_name: row.courier_name,
+        tracking_number: row.tracking_number, events: (row.events || []).map(({ status, label, at }) => ({ status, label, at })) })) });
+  } catch (error) {
+    console.error('get-checkout-order failed', error);
+    return Response.json({ error: 'Commande temporairement indisponible' }, { status: 503 });
+  }
+}
