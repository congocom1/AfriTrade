+import { withCommerceLock } from './commerceLock.ts';
+import { ledgerBalance } from './ledger.ts';
+
+export async function releaseServerPayout(base44, user, fulfillmentId) {
+  if (user?.role !== 'admin') throw new Error('ADMIN_REQUIRED');
+  return withCommerceLock(base44, 'release-payout', gate => releaseLockedPayout(base44, fulfillmentId, gate));
+}
+async function releaseLockedPayout(base44, fulfillmentId, gate) {
+  const db = base44.asServiceRole.entities;
+  const fulfillment = await db.FulfillmentOrder.get(fulfillmentId);
+  if (!fulfillment) throw new Error('FULFILLMENT_NOT_FOUND');
+  const order = await db.Order.get(fulfillment.order_id);
+  if (!order || order.payment_status !== 'PAID' || order.payment_verified !== true || order.is_demo ||
+      fulfillment.is_demo || fulfillment.status !== 'DELIVERED' || order.status === 'CANCELLED')
+    throw new Error('PAYOUT_NOT_ELIGIBLE');
+  const rows = await db.WalletTransaction.filter({ reference: fulfillment.fulfillment_number }, 'created_date', 500);
+  if (rows.length >= 500) throw new Error('PAYOUT_REQUIRES_REVIEW');
+  const credits = rows.filter(tx => tx.direction === 'credit' && ['pending','posted'].includes(tx.status));
+  if (!credits.length) throw new Error('PAYOUT_REQUIRES_REVIEW');
+  const seen = new Set();
+  for (const tx of credits) {
+    if (tx.order_id !== order.id || !tx.idempotency_key || seen.has(tx.idempotency_key) ||
+        !Number.isFinite(Number(tx.amount_usd)) || Number(tx.amount_usd) <= 0)
+      throw new Error('INVALID_PAYOUT_LEDGER');
+    seen.add(tx.idempotency_key);
+  }
+  await gate.markDirty();
+  // Update stable ledger ids, never create another credit on retry.
+  for (const tx of credits) if (tx.status === 'pending') await db.WalletTransaction.update(tx.id, { status: 'posted' });
+  for (const id of new Set(credits.map(tx => tx.wallet_id))) {
+    const totals = await ledgerBalance(base44, id);
+    await db.Wallet.update(id, { balance_usd: totals.balance, lifetime_credit_usd: totals.credits, lifetime_debit_usd: totals.debits });
+  }
+  await db.FulfillmentOrder.update(fulfillment.id, { payout_released: true });
+  return { released: true, count: credits.length };
+}
diff --git a/base44/shared/walletPayments.ts b/base44/shared/walletPayments.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f6ba79d7244b48e2f1b0f3ed15085a5bd1a9aee0
--- /dev/null
+++ b/base44/shared/walletPayments.ts
@@ -0,0 +1,55 @@
+import { issueInvoiceNumber } from './invoiceSequence.ts';
+import { withCommerceLock } from './commerceLock.ts';
+import { ledgerBalance } from './ledger.ts';
+import { mayReadOrder, CheckoutError, publicOrder } from './checkoutService.ts';
+
+export async function chargeWalletOrder(base44, user, body) {
+  if (!user?.id || !user?.email) throw new CheckoutError('Connectez-vous pour payer avec votre portefeuille.', 401);
+  if (body.provider !== 'wallet') throw new CheckoutError('Prestataire mobile money non connecté.', 503);
+  return withCommerceLock(base44, 'wallet-payment', async gate => {
+    const db = base44.asServiceRole.entities;
+    const rows = await db.Order.filter({ order_number: String(body.order_number || '') }, 'created_date', 2);
+    const order = rows.length === 1 ? rows[0] : null;
+    if (!(await mayReadOrder(order, user, body.access_token))) throw new CheckoutError('Commande non autorisée.', 403);
+    if (!order.server_priced || !order.checkout_ready || order.inventory_status !== 'reserved' ||
+        order.payment_provider !== 'wallet' || order.is_demo || order.status === 'CANCELLED')
+      throw new CheckoutError('Commande non payable.', 409);
+    if (order.payment_status === 'PAID' && order.payment_verified === true)
+      return { status: 'PAID', duplicate: true, order: publicOrder(order) };
+    if (order.payment_status !== 'PENDING') throw new CheckoutError('Commande non payable.', 409);
+    const amount = Number(order.total_usd);
+    if (!(amount > 0) || !Number.isFinite(amount) || !Number.isSafeInteger(Math.round(amount * 100)))
+      throw new CheckoutError('Montant invalide.');
+    const wallets = await db.Wallet.filter({ owner_type: 'customer', owner_email: user.email }, 'created_date', 2);
+    if (wallets.length !== 1) throw new CheckoutError('Portefeuille absent ou ambigu.', 409);
+    const wallet = wallets[0];
+    if (wallet.status === 'frozen') throw new CheckoutError('Portefeuille gelé.', 409);
+    const idempotencyKey = 'wallet:' + order.id;
+    const existing = await db.WalletTransaction.filter({ idempotency_key: idempotencyKey }, 'created_date', 2);
+    if (existing.length) throw new CheckoutError('Un débit existe déjà : vérification requise.', 409);
+    const totals = await ledgerBalance(base44, wallet.id);
+    if (Math.round(amount * 100) > Math.round(totals.balance * 100)) throw new CheckoutError('Solde insuffisant.', 409);
+    const fulfillments = await db.FulfillmentOrder.filter({ order_id: order.id }, 'fulfillment_number', 100);
+    if (fulfillments.length !== order.fulfillment_count) throw new CheckoutError('Préparation incomplète.', 409);
+    await gate.markDirty();
+    await db.WalletTransaction.create({
+      wallet_id: wallet.id, tenant_id: wallet.tenant_id || '', tenant_owner_email: user.email,
+      owner_type: 'customer', owner_name: wallet.owner_name, type: 'DEBIT', direction: 'debit',
+      amount_usd: amount, currency: 'USD', status: 'posted', idempotency_key: idempotencyKey,
+      order_id: order.id, order_number: order.order_number, reference: order.order_number,
+      description: 'Achat — ' + order.order_number,
+    });
+    const invoiceNumber = await issueInvoiceNumber(db, order);
+    const paid = await db.Order.update(order.id, {
+      invoice_number: invoiceNumber,
+      payment_status: 'PAID', payment_verified: true, payment_reference: 'WALLET-' + order.id,
+      status: 'CONFIRMED',
+    });
+    for (const fulfillment of fulfillments) {
+      await db.FulfillmentOrder.updateMany({ id: fulfillment.id, status: 'PENDING' }, { $set: { status: 'CONFIRMED' } });
+    }
+    const balance = await ledgerBalance(base44, wallet.id);
+    await db.Wallet.update(wallet.id, { balance_usd: balance.balance, lifetime_credit_usd: balance.credits, lifetime_debit_usd: balance.debits });
+    return { status: 'PAID', payment_verified: true, order: publicOrder(paid), total_usd: amount };
+  });
+}
diff --git a/base44/shared/withdrawalService.ts b/base44/shared/withdrawalService.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dc674ff998a698352e509f18ee1b626567d9341d
--- /dev/null
+++ b/base44/shared/withdrawalService.ts
@@ -0,0 +1,96 @@
+import { withCommerceLock } from './commerceLock.ts';
+import { ledgerBalance } from './ledger.ts';
+import { CheckoutError } from './checkoutService.ts';
+
+async function ownsWallet(db, wallet, user) {
+  if (user.role === 'admin') return true;
+  if (String(wallet.owner_email || '').toLowerCase() === String(user.email || '').toLowerCase() && user.email) return true;
+  const entity = { seller: 'Seller', creator: 'Creator', courier: 'Courier' }[wallet.owner_type];
+  if (!entity || !wallet.owner_id) return false;
+  const partner = await db[entity].get(wallet.owner_id);
+  return !!user.email && String(partner?.email || '').toLowerCase() === user.email.toLowerCase();
+}
+export async function reserveWithdrawal(base44, user, body) {
+  if (!user?.id || !user.email) throw new CheckoutError('Authentification requise.', 401);
+  const cents = Math.round(Number(body.amount) * 100);
+  if (!Number.isFinite(Number(body.amount)) || !Number.isSafeInteger(cents) || cents <= 0)
+    throw new CheckoutError('Montant invalide.');
+  if (!/^[a-f0-9-]{36}$/.test(String(body.request_id || ''))) throw new CheckoutError('Identifiant de demande invalide.');
+  const method = String(body.method || 'M-Pesa').trim();
+  if (!method || method.length > 80) throw new CheckoutError('Méthode invalide.');
+  return withCommerceLock(base44, 'withdrawal-reservation', async gate => {
+    const db = base44.asServiceRole.entities;
+    const wallet = await db.Wallet.get(String(body.wallet_id || ''));
+    if (!wallet || !(await ownsWallet(db, wallet, user))) throw new CheckoutError('Portefeuille non autorisé.', 403);
+    if (wallet.status === 'frozen') throw new CheckoutError('Portefeuille gelé.', 409);
+    const key = 'withdrawal:' + wallet.id + ':' + user.id + ':' + body.request_id;
+    const prior = (await db.WalletWithdrawalRequest.filter({ idempotency_key: key }, 'created_date', 2))[0];
+    if (prior) {
+      if (!prior.funds_reserved || prior.amount_usd !== cents / 100 || prior.method !== method)
+        throw new CheckoutError('Demande existante à vérifier.', 409);
+      return { ok: true, wallet, request_id: prior.id, amount_usd: prior.amount_usd, funds_reserved: true, status: prior.status, duplicate: true };
+    }
+    const totals = await ledgerBalance(base44, wallet.id);
+    if (cents > Math.round(totals.balance * 100)) throw new CheckoutError('Montant supérieur au solde disponible.', 409);
+    await gate.markDirty();
+    const request = await db.WalletWithdrawalRequest.create({
+      wallet_id: wallet.id, requester_id: user.id, requester_email: user.email,
+      amount_usd: cents / 100, method, status: 'requested', idempotency_key: key, funds_reserved: false,
+      description: 'Fonds réservés — transfert externe à effectuer puis à confirmer par un administrateur.',
+    });
+    const debit = await db.WalletTransaction.create({
+      wallet_id: wallet.id, tenant_id: wallet.tenant_id || '', tenant_owner_email: wallet.owner_email || user.email,
+      owner_type: wallet.owner_type, owner_name: wallet.owner_name, type: 'PAYOUT', direction: 'debit',
+      amount_usd: cents / 100, currency: 'USD', status: 'pending', idempotency_key: key,
+      reference: request.id, description: 'Réservation de retrait vers ' + method,
+    });
+    await db.WalletWithdrawalRequest.update(request.id, { transaction_id: debit.id, funds_reserved: true });
+    const updated = await db.Wallet.update(wallet.id, {
+      balance_usd: (Math.round(totals.balance * 100) - cents) / 100,
+      lifetime_credit_usd: totals.credits, lifetime_debit_usd: (Math.round(totals.debits * 100) + cents) / 100,
+    });
+    return { ok: true, wallet: updated, request_id: request.id, amount_usd: cents / 100,
+      balance_usd: updated.balance_usd, funds_reserved: true, status: 'requested' };
+  });
+}
+export async function reviewWithdrawal(base44, user, body) {
+  if (user?.role !== 'admin') throw new CheckoutError('Accès refusé.', 403);
+  if (!['review','reject','settle'].includes(body.action)) throw new CheckoutError('Action invalide.');
+  const reference = String(body.reference || '').trim();
+  if (body.action === 'settle' && (!reference || reference.length > 200 || body.transfer_confirmed !== true))
+    throw new CheckoutError('Confirmez le transfert déjà effectué et sa référence.');
+  return withCommerceLock(base44, 'review-withdrawal', async gate => {
+    const db = base44.asServiceRole.entities;
+    if (body.legacy) {
+      if (body.action !== 'reject') throw new CheckoutError('Action non disponible pour ce retrait.', 409);
+      const tx = await db.WalletTransaction.get(body.id);
+      if (!tx || tx.type !== 'PAYOUT' || tx.direction !== 'debit' || !['pending','reversed'].includes(tx.status))
+        throw new CheckoutError('Retrait non annulable.', 409);
+      await gate.markDirty();
+      if (tx.status === 'pending') await db.WalletTransaction.update(tx.id, { status: 'reversed' });
+      const totals = await ledgerBalance(base44, tx.wallet_id);
+      await db.Wallet.update(tx.wallet_id, { balance_usd: totals.balance, lifetime_credit_usd: totals.credits, lifetime_debit_usd: totals.debits });
+      return { ok: true };
+    }
+    const row = await db.WalletWithdrawalRequest.get(body.id);
+    if (!row) throw new CheckoutError('Demande introuvable.', 404);
+    if (row.status === 'settled' && body.action === 'settle' && row.settlement_reference === reference) return { ok: true, duplicate: true };
+    if (row.status === 'rejected' && body.action === 'reject') return { ok: true, duplicate: true };
+    if (!['requested','reviewing'].includes(row.status)) throw new CheckoutError('Demande non modifiable.', 409);
+    const tx = row.transaction_id ? await db.WalletTransaction.get(row.transaction_id) : null;
+    if (row.funds_reserved && (!tx || tx.wallet_id !== row.wallet_id || tx.direction !== 'debit' || tx.status !== 'pending' || tx.amount_usd !== row.amount_usd))
+      throw new CheckoutError('Réservation à rapprocher avant traitement.', 409);
+    if (body.action === 'settle' && !row.funds_reserved) throw new CheckoutError('Cette ancienne demande ne réserve aucun fonds : rapprochez-la avant règlement.', 409);
+    await gate.markDirty();
+    if (tx && body.action !== 'review') await db.WalletTransaction.update(tx.id, { status: body.action === 'reject' ? 'reversed' : 'posted' });
+    await db.WalletWithdrawalRequest.update(row.id, {
+      status: body.action === 'settle' ? 'settled' : body.action === 'reject' ? 'rejected' : 'reviewing',
+      ...(body.action === 'settle' ? { settlement_reference: reference, settled_at: new Date().toISOString(), settled_by: user.id } : {}),
+    });
+    if (tx) {
+      const totals = await ledgerBalance(base44, tx.wallet_id);
+      await db.Wallet.update(tx.wallet_id, { balance_usd: totals.balance, lifetime_credit_usd: totals.credits, lifetime_debit_usd: totals.debits });
+    }
+    return { ok: true };
+  });
+}
