{
  "description": "Pr\u00e9vient le vendeur d\u00e8s qu'une date de livraison ou un d\u00e9p\u00f4t en point relais est confirm\u00e9 pour une de ses commandes.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "FulfillmentOrder"
    },
    "condition": "${ ((.trigger.data.estimated_delivery // \"\") != \"\" and (.trigger.event_type == \"create\" or (.trigger.old_data.estimated_delivery // \"\") != .trigger.data.estimated_delivery)) or (.trigger.data.status == \"READY_FOR_PICKUP\" and (.trigger.old_data.status // \"\") != \"READY_FOR_PICKUP\") }"
  },
  "name": "Alerte vendeur livraison confirmee",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "delivery_confirmed_seller_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_seller": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySellerDeliveryConfirmed",
            "args": {
              "fulfillment_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Pr\u00e9venir le vendeur",
            "description": "Date de livraison ou d\u00e9p\u00f4t confirm\u00e9"
          }
        }
      }
    ]
  }
}