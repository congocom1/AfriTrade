+import { createClientFromRequest } from 'npm:@base44/sdk@0.8.54';
+import { reviewWithdrawal } from '../../shared/withdrawalService.ts';
+import { CheckoutError } from '../../shared/checkoutService.ts';
+import { CommerceBusyError } from '../../shared/commerceLock.ts';
+export default async function(req) {
+  if (req.method !== 'POST') return Response.json({ error: 'Méthode interdite' }, { status: 405 });
+  try {
+    const base44 = createClientFromRequest(req);
+    const user = await base44.auth.me().catch(() => null);
+    return Response.json(await reviewWithdrawal(base44, user, await req.json()));
+  } catch (error) {
+    if (error instanceof CheckoutError || error instanceof CommerceBusyError)
+      return Response.json({ error: error.message }, { status: error.status });
+    console.error('review-withdrawal failed', error);
+    return Response.json({ error: 'Demande à vérifier avant de réessayer.' }, { status: 503 });
+  }
+}
