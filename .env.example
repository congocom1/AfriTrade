# AfriTrade — local development environment template
# Copy this file to .env.local and fill in values as needed.
# .env.local is gitignored — never commit real credentials.

# ── Public build configuration (safe to commit as examples) ──
# These identify the Base44 app and are not secrets. Set correct
# values for your environment; staging and production must differ.
VITE_BASE44_APP_ID=your-base44-app-id
VITE_BASE44_FUNCTIONS_VERSION=1
VITE_BASE44_APP_BASE_URL=http://localhost:5174

# ── Base44 CLI ──
# Run `base44 login` and `base44 link` before local development.
# The CLI reads credentials from its own config, not from this file.

# ── Backend secrets (NEVER commit real values) ──
# These live in the Base44 backend secret store, not in the frontend.
# Do not set them here unless you are certain they are public identifiers.
# WIX_CHECKOUT_API_KEY=your-wix-checkout-api-key
# WIX_CHECKOUT_SITE_ID=your-wix-checkout-site-id
# WIX_CHECKOUT_APP_URL=https://your-store.base44.app
# WIX_CHECKOUT_WEBHOOK_PUBLIC_KEY=your-webhook-public-key

# ── CI ──
# STAGING_BASE_URL is a repository variable used by the optional staging
# smoke job in .github/workflows/ci.yml. It is not a secret, but it must
# point to an approved nonproduction origin.
# STAGING_BASE_URL=https://staging-afritrade.base44.app
