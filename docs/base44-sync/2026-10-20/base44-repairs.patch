@@ -0,0 +1,15 @@
+/** Call only while holding the durable commerce gate, after marking the operation dirty. */
+export async function issueInvoiceNumber(db, order) {
+  if (order.invoice_number) return order.invoice_number;
+  const year = Number(new Intl.DateTimeFormat('en', { year: 'numeric', timeZone: 'Africa/Kinshasa' }).format(new Date()));
+  const rows = await db.PlatformSetting.filter({ key: 'invoice_counter' }, 'created_date', 2);
+  if (rows.length > 1) throw new Error('Ambiguous invoice counter');
+  const current = rows[0];
+  const previous = current?.value?.year === year ? Number(current.value.seq) : 0;
+  if (!Number.isSafeInteger(previous) || previous < 0 || previous >= Number.MAX_SAFE_INTEGER)
+    throw new Error('Invalid invoice counter');
+  const value = { year, seq: previous + 1 };
+  if (current) await db.PlatformSetting.update(current.id, { value });
+  else await db.PlatformSetting.create({ key: 'invoice_counter', label: 'Compteur de factures', group: 'compliance', value });
+  return 'FA-' + year + '-' + String(value.seq).padStart(5, '0');
+}
