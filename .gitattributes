# Consistent text, without retroactively rewriting repository history.
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.pdf binary
*.glb binary
*.gltf text
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.lock text eol=lf
