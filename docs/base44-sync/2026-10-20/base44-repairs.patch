diff --git a/base44/shared/checkoutCancellation.ts b/base44/shared/checkoutCancellation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ccca6a39ee0455a37d81f711e629c7a300e5a6ce
--- /dev/null
+++ b/base44/shared/checkoutCancellation.ts
@@ -0,0 +1,61 @@
+import { withCommerceLock } from './commerceLock.ts';
+import { mayReadOrder, CheckoutError, publicOrder } from './checkoutService.ts';
+
+export async function cancelServerOrder(base44, user, body) {
+  return withCommerceLock(base44, 'cancel-checkout', async gate => {
+    const db = base44.asServiceRole.entities;
+    const rows = await db.Order.filter({ order_number: String(body.order_number || '') }, 'created_date', 2);
+    const order = rows.length === 1 ? rows[0] : null;
+    if (!(await mayReadOrder(order, user, body.access_token))) throw new CheckoutError('Commande non autorisée.', 403);
+    if (order.status === 'CANCELLED' && order.inventory_status === 'released') return { order: publicOrder(order), duplicate: true };
+    if (!order.server_priced || !order.checkout_ready || order.payment_status !== 'PENDING' ||
+        order.status !== 'PENDING' || order.card_checkout_claimed)
+      throw new CheckoutError('Cette commande ne peut pas être annulée automatiquement. Un paiement ou une préparation peut être en cours.', 409);
+    await gate.markDirty();
+    const claimed = await db.Order.updateMany({ id: order.id, status: 'PENDING', payment_status: 'PENDING', card_checkout_claimed: { $ne: true } }, {
+      $set: { status: 'CANCELLED', payment_status: 'CANCELLED', checkout_ready: false },
+    });
+    if (claimed.updated !== 1) return { conflict: true };
+    const quantities = new Map();
+    for (const item of order.items || []) quantities.set(item.product_id, (quantities.get(item.product_id) || 0) + Number(item.quantity));
+    for (const [id, quantity] of quantities) {
+      const product = await db.Product.get(id);
+      if (!product || !Number.isSafeInteger(quantity) || quantity <= 0) throw new Error('Invalid reservation');
+      const released = await db.Product.updateMany({ id, inventory_reservations: order.id }, {
+        $inc: { stock: quantity }, $set: { sold_count: Math.max(0, Number(product.sold_count || 0) - quantity) },
+        $pull: { inventory_reservations: order.id },
+      });
+      if (released.updated !== 1) throw new Error('Missing inventory reservation');
+    }
+    if (order.coupon_code) {
+      const coupon = (await db.Coupon.filter({ code: order.coupon_code }, 'created_date', 1))[0];
+      if (!coupon) throw new Error('Coupon reservation missing');
+      const released = await db.Coupon.updateMany({ id: coupon.id, order_uses: order.id, usage_count: { $gte: 1 } }, {
+        $inc: { usage_count: -1 }, $pull: { order_uses: order.id },
+      });
+      if (released.updated !== 1) throw new Error('Coupon reservation not released');
+    }
+    const credits = await db.WalletTransaction.filter({ order_id: order.id, direction: 'credit' }, 'created_date', 500);
+    if (credits.length >= 500 || credits.some(tx => tx.status !== 'pending')) throw new Error('Ledger requires review');
+    for (const tx of credits) await db.WalletTransaction.update(tx.id, { status: 'reversed' });
+    const fulfillments = await db.FulfillmentOrder.filter({ order_id: order.id }, 'fulfillment_number', 100);
+    for (const row of fulfillments) await db.FulfillmentOrder.update(row.id, { status: 'CANCELLED' });
+    const canceled = await db.Order.update(order.id, { inventory_status: 'released' });
+    return { order: publicOrder(canceled) };
+  });
+}
+export async function expireUnclaimedCheckouts(base44, user) {
+  if (user?.role !== 'admin') throw new CheckoutError('Accès administrateur requis.', 403);
+  const rows = await base44.asServiceRole.entities.Order.filter({
+    payment_status: 'PENDING', status: 'PENDING', server_priced: true, checkout_ready: true,
+    payment_provider: { $in: ['card', 'wallet'] }, card_checkout_claimed: { $ne: true },
+    checkout_expires_at: { $lte: new Date().toISOString() },
+  }, 'checkout_expires_at', 10);
+  let expired = 0;
+  for (const row of rows) {
+    if (!row.checkout_expires_at || !Number.isFinite(Date.parse(row.checkout_expires_at))) continue;
+    const result = await cancelServerOrder(base44, user, { order_number: row.order_number });
+    if (!result.conflict) expired++;
+  }
+  return { expired };
+}
diff --git a/base44/shared/checkoutService.ts b/base44/shared/checkoutService.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2dbbabd638f248b2b5f7c0fccdfb9281005d094d
--- /dev/null
+++ b/base44/shared/checkoutService.ts
@@ -0,0 +1,209 @@
+import { withCommerceLock } from './commerceLock.ts';
+import { recomputeOrderTotals, round2 } from './orderPricing.ts';
+
+export class CheckoutError extends Error {
+  status: number;
+  constructor(message, status = 400) { super(message); this.status = status; }
+}
+export function textField(value, max = 200) { return String(value ?? '').trim().slice(0, max); }
+export async function tokenHash(value) {
+  const bytes = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value));
+  return [...new Uint8Array(bytes)].map(x => x.toString(16).padStart(2, '0')).join('');
+}
+export async function mayReadOrder(order, user, accessToken) {
+  if (!order) return false;
+  if (user?.role === 'admin' || (user?.id && order.customer_user_id === user.id)) return true;
+  return typeof accessToken === 'string' && accessToken.length >= 32 &&
+    !!order.checkout_token_hash && await tokenHash(accessToken) === order.checkout_token_hash;
+}
+export function publicOrder(order) {
+  const { checkout_token_hash, checkout_request_hash, session_id, ...safe } = order;
+  return safe;
+}
+export function publicFulfillment(row) {
+  const keys = ['id','order_id','order_number','fulfillment_number','source_type','seller_name','supplier_name',
+    'status','courier_name','tracking_number','estimated_delivery'];
+  return { ...Object.fromEntries(keys.map(key => [key, row[key]])),
+    items: (row.items || []).map(({ supplier_cost_usd, ...item }) => item) };
+}
+function positiveConfig(value, fallback, max = Number.MAX_SAFE_INTEGER) {
+  const n = Number(value ?? fallback);
+  if (!Number.isFinite(n) || n < 0 || n > max) throw new CheckoutError('Configuration commerciale invalide', 503);
+  return n;
+}
+async function pendingCredit(db, owner, amount, order, fulfillment, kind) {
+  if (!(amount > 0)) return;
+  const rows = await db.Wallet.filter({ owner_type: owner.type, owner_id: owner.id }, 'created_date', 2);
+  if (rows.length > 1) throw new CheckoutError('Portefeuille ambigu, vérification requise.', 409);
+  const wallet = rows[0] || await db.Wallet.create({
+    owner_type: owner.type, owner_id: owner.id, owner_name: owner.name, owner_email: owner.email || '',
+    tenant_id: fulfillment.tenant_id || '', tenant_owner_email: owner.email || '', balance_usd: 0,
+  });
+  await db.WalletTransaction.create({
+    wallet_id: wallet.id, tenant_id: wallet.tenant_id || '', tenant_owner_email: wallet.tenant_owner_email || owner.email || '',
+    owner_type: owner.type, owner_name: owner.name, type: kind, direction: 'credit', amount_usd: amount,
+    currency: 'USD', status: 'pending', order_id: order.id, order_number: order.order_number,
+    reference: fulfillment.fulfillment_number, idempotency_key: owner.type + ':' + fulfillment.fulfillment_number,
+    description: 'À libérer après paiement vérifié et livraison — ' + fulfillment.fulfillment_number,
+  });
+}
+export async function placeServerOrder(base44, user, body) {
+  return withCommerceLock(base44, 'place-order', gate => placeLockedOrder(base44, user, body, gate));
+}
+async function placeLockedOrder(base44, user, body, gate) {
+  const db = base44.asServiceRole.entities;
+  const profile = body.profile || {};
+  const delivery = body.delivery || {};
+  const accessToken = textField(body.access_token, 100);
+  const requestId = textField(body.request_id, 100);
+  if (!/^[a-f0-9]{64}$/.test(accessToken) || !/^[a-f0-9-]{36}$/.test(requestId))
+    throw new CheckoutError('Identifiant de commande invalide');
+  if (body.consent?.terms !== true) throw new CheckoutError('Acceptez les conditions générales.');
+  if (!['card', 'cod', 'wallet'].includes(body.paymentMethodId))
+    throw new CheckoutError('Ce moyen de paiement est temporairement indisponible.', 503);
+  if (body.paymentMethodId === 'wallet' && !user?.id) throw new CheckoutError('Connexion requise pour le portefeuille.', 401);
+  if (!textField(profile.name) || !textField(profile.phone) || !textField(profile.city))
+    throw new CheckoutError('Nom, téléphone et ville requis.');
+  if (delivery.method === 'home_delivery' && !textField(delivery.address || profile.address, 500))
+    throw new CheckoutError('Adresse de livraison requise.');
+  const hash = await tokenHash(accessToken);
+  const requestHash = await tokenHash(hash + ':' + requestId);
+  const prior = (await db.Order.filter({ checkout_request_hash: requestHash }, 'created_date', 2))[0];
+  if (prior) {
+    if (!(await mayReadOrder(prior, user, accessToken))) throw new CheckoutError('Accès refusé', 403);
+    if (!prior.checkout_ready) throw new CheckoutError('Cette commande nécessite une vérification par notre équipe. Ne recréez pas le paiement.', 409);
+    return { order: publicOrder(prior), payment: { status: prior.payment_status }, duplicate: true };
+  }
+  const input = { items: body.items, city: textField(profile.city), delivery_method: delivery.method,
+    pickup_point_id: textField(delivery.pickup_point_id), coupon_code: textField(body.couponCode, 80).toUpperCase() };
+  const pricing = await recomputeOrderTotals(base44, input);
+  if (pricing.ok === false) throw new CheckoutError(pricing.reason);
+  if (body.paymentMethodId === 'card' && pricing.total < 0.5) throw new CheckoutError('Le paiement par carte exige au moins 0,50 USD.');
+  // Settings are admin-owned. Referral-specific rates are not trusted: creators may edit their own profiles.
+  const configs = await Promise.all(['pricing','country','tax'].map(async key =>
+    [key, (await db.PlatformSetting.filter({ key }, 'created_date', 1))[0]?.value || {}]));
+  const cfg = Object.fromEntries(configs);
+  const vatRate = cfg.tax.enabled === false ? 0 : positiveConfig(cfg.tax.vat_rate, 16, 100);
+  const cdfRate = positiveConfig(cfg.country.usd_to_cdf_rate, 2800);
+  const sellerRate = positiveConfig(cfg.pricing.seller_commission_percent, 10, 100);
+  const creatorRate = positiveConfig(cfg.pricing.creator_commission_percent, 8, 100);
+  const referral = textField(body.referral_code, 80);
+  const creator = referral ? (await db.Creator.filter({ referral_code: referral }, 'created_date', 1))[0] : null;
+  let pickup = null;
+  if (input.delivery_method === 'pickup_point') {
+    pickup = await db.PickupPoint.get(input.pickup_point_id);
+    if (!pickup || pickup.active === false || pickup.city !== input.city) throw new CheckoutError('Point de retrait indisponible dans cette ville.');
+  }
+  const orderNumber = 'CC-' + new Date().getFullYear() + '-' + crypto.randomUUID().replaceAll('-', '').toUpperCase();
+  const totalHt = round2(pricing.total / (1 + vatRate / 100));
+  const items = pricing.lines.map((line, i) => ({
+    product_id: line.product.id, title: line.product.title, image: line.product.images?.[0] || '',
+    quantity: line.quantity, variant: textField(body.items[i]?.variant, 120) || null,
+    unit_price_usd: line.unit_price_usd, line_total_usd: line.line_total_usd,
+    source_type: line.product.source_type, seller_name: line.product.seller_name || line.product.supplier_name || '',
+  }));
+  const groups = new Map();
+  pricing.lines.forEach((line, i) => {
+    const p = line.product;
+    const key = p.source_type === 'local_seller' ? 'seller:' + p.seller_id : 'supplier:' + (p.supplier_id || 'platform');
+    if (!groups.has(key)) groups.set(key, []);
+    groups.get(key).push({ ...line, item: items[i] });
+  });
+  // Validate every cost BEFORE the first write.
+  for (const line of pricing.lines) positiveConfig(line.product.supplier_price ?? line.product.price_usd, 0);
+  await gate.markDirty();
+  const order = await db.Order.create({
+    order_number: orderNumber, checkout_token_hash: hash, checkout_request_hash: requestHash,
+    customer_user_id: user?.id || '', server_priced: true, checkout_ready: false, inventory_status: 'processing',
+    customer_name: textField(profile.name), customer_phone: textField(profile.phone, 50),
+    customer_email: textField(user?.email || profile.email), city: input.city,
+    address: textField(delivery.address || profile.address, 500), delivery_method: input.delivery_method,
+    pickup_point_id: pickup?.id || '', pickup_point_name: pickup?.name || '',
+    pickup_code: pickup ? String(crypto.getRandomValues(new Uint32Array(1))[0] % 900000 + 100000) : '',
+    notes: textField(delivery.notes, 1000), items, subtotal_usd: pricing.subtotal,
+    shipping_usd: pricing.shipping, discount_usd: pricing.discount, total_usd: pricing.total,
+    total_cdf: round2(pricing.total * cdfRate), currency: 'USD', payment_provider: body.paymentMethodId,
+    payment_method: body.paymentMethodId === 'card' ? 'Carte bancaire (Visa / Mastercard)' : body.paymentMethodId === 'wallet' ? 'Portefeuille Congo Commerce' : 'Paiement à la livraison',
+    checkout_expires_at: body.paymentMethodId === 'cod' ? '' : new Date(Date.now() + 30 * 60 * 1000).toISOString(),
+    card_checkout_claimed: false, payment_status: 'PENDING', payment_verified: false, status: 'PENDING', is_demo: false,
+    coupon_code: input.coupon_code, affiliate_code: creator?.referral_code || '', creator_id: creator?.id || '',
+    fulfillment_count: groups.size, vat_rate: vatRate, vat_usd: round2(pricing.total - totalHt), total_ht_usd: totalHt,
+    // Fiscal invoice numbering belongs to settlement; never race on a browser-owned counter.
+    invoice_number: '', consent_terms: true, consent_marketing: body.consent?.marketing === true,
+    consent_at: new Date().toISOString(),
+  });
+  try {
+    let index = 0, allocatedDiscount = 0, cumulativeSubtotal = 0;
+    const fulfillments = [];
+    for (const lines of groups.values()) {
+      const p = lines[0].product;
+      const subtotal = round2(lines.reduce((sum, line) => sum + line.line_total_usd, 0));
+      ++index;
+      cumulativeSubtotal = round2(cumulativeSubtotal + subtotal);
+      const cumulativeDiscount = index === groups.size ? pricing.discount
+        : round2(pricing.discount * cumulativeSubtotal / pricing.subtotal);
+      const discount = round2(cumulativeDiscount - allocatedDiscount);
+      allocatedDiscount = cumulativeDiscount;
+      const net = round2(subtotal - discount);
+      const cost = round2(lines.reduce((sum, line) => sum + Number(line.product.supplier_price ?? line.product.price_usd) * line.quantity, 0));
+      const sellerPayout = p.source_type === 'local_seller' ? round2(net * (1 - sellerRate / 100)) : 0;
+      const margin = round2(net - (p.source_type === 'local_seller' ? sellerPayout : cost));
+      const creatorCommission = creator ? Math.min(Math.max(0, margin), round2(net * creatorRate / 100)) : 0;
+      fulfillments.push(await db.FulfillmentOrder.create({
+        order_id: order.id, order_number: orderNumber, fulfillment_number: orderNumber + '-F' + index,
+        tenant_id: p.tenant_id || '', tenant_owner_email: p.tenant_owner_email || '',
+        source_type: p.source_type, seller_id: p.seller_id || '', seller_name: p.seller_name || '',
+        supplier_id: p.supplier_id || '', supplier_name: p.supplier_name || '',
+        items: lines.map(line => ({ ...line.item, supplier_cost_usd: round2(Number(line.product.supplier_price ?? line.product.price_usd) * line.quantity) })),
+        subtotal_usd: subtotal, discount_usd: discount, shipping_usd: 0, supplier_cost_usd: cost,
+        seller_payout_usd: sellerPayout, creator_commission_usd: creatorCommission,
+        platform_revenue_usd: round2(margin - creatorCommission), status: 'PENDING', payout_released: false, is_demo: false,
+      }));
+    }
+    for (const fulfillment of fulfillments) {
+      if (fulfillment.seller_id && fulfillment.seller_payout_usd > 0) {
+        const seller = await db.Seller.get(fulfillment.seller_id);
+        if (!seller) throw new CheckoutError('Vendeur indisponible.', 409);
+        await pendingCredit(db, { type: 'seller', id: seller.id, name: seller.name, email: seller.email },
+          fulfillment.seller_payout_usd, order, fulfillment, 'PAYOUT');
+      }
+      if (creator && fulfillment.creator_commission_usd > 0) {
+        await pendingCredit(db, { type: 'creator', id: creator.id, name: creator.name, email: creator.email },
+          fulfillment.creator_commission_usd, order, fulfillment, 'COMMISSION');
+      }
+      await pendingCredit(db, { type: 'platform', id: 'platform', name: 'Congo Commerce', email: '' },
+        fulfillment.platform_revenue_usd, order, fulfillment, 'COMMISSION');
+    }
+    // Conditional single-record decrements protect stock even across competing requests.
+    // The global commerce gate also protects multi-record accounting and duplicate creation.
+    const quantities = new Map();
+    for (const line of pricing.lines) quantities.set(line.product.id, (quantities.get(line.product.id) || 0) + line.quantity);
+    for (const [id, quantity] of quantities) {
+      const product = await db.Product.get(id);
+      if (!Number.isFinite(Number(product.stock)) || Number(product.stock) < quantity) throw new CheckoutError('Stock modifié pendant la commande.', 409);
+      const reserved = await db.Product.updateMany({ id, stock: { $gte: quantity }, inventory_reservations: { $ne: order.id } }, {
+        $inc: { stock: -quantity },
+        $set: { sold_count: Number(product.sold_count || 0) + quantity },
+        $addToSet: { inventory_reservations: order.id },
+      });
+      if (reserved.updated !== 1) throw new CheckoutError('Réservation de stock refusée.', 409);
+    }
+    if (input.coupon_code) {
+      const coupon = (await db.Coupon.filter({ code: input.coupon_code }, 'created_date', 1))[0];
+      if (!coupon) throw new CheckoutError('Code promo indisponible.', 409);
+      const used = Number(coupon.usage_count || 0);
+      if (Number(coupon.usage_limit) > 0 && used >= Number(coupon.usage_limit)) throw new CheckoutError('Code promo épuisé.', 409);
+      const consumed = await db.Coupon.updateMany({ id: coupon.id, usage_count: coupon.usage_count ?? null, order_uses: { $ne: order.id } }, {
+        $set: { usage_count: used + 1 }, $addToSet: { order_uses: order.id },
+      });
+      if (consumed.updated !== 1) throw new CheckoutError('Code promo modifié pendant la commande.', 409);
+    }
+    const ready = await db.Order.update(order.id, { checkout_ready: true, inventory_status: 'reserved' });
+    // No fake shipments, spendable credits or confirmation email before gateway settlement.
+    return { order: publicOrder(ready), fulfillments: fulfillments.map(publicFulfillment),
+      payment: { status: 'PENDING' }, quote: { subtotal: pricing.subtotal, shipping: pricing.shipping, discount: pricing.discount, total: pricing.total } };
+  } catch (error) {
+    await db.Order.update(order.id, { checkout_ready: false, inventory_status: 'review_required' }).catch(() => null);
+    throw new CheckoutError('Commande ' + orderNumber + ' enregistrée mais incomplète. Contactez notre équipe avant de réessayer.', 409);
+  }
+}
diff --git a/base44/shared/commerceLock.ts b/base44/shared/commerceLock.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8f051dcbee6018d6a6751d8e253b4c08ba19041c
--- /dev/null
+++ b/base44/shared/commerceLock.ts
@@ -0,0 +1,44 @@
+// Provisioned once for this app. Never create a singleton lazily in competing requests.
+export const COMMERCE_CONTROL_ID = '6ad6b6758f2fd61c242969e0';
+export class CommerceBusyError extends Error {
+  status = 409;
+  constructor() { super('Une opération commerciale est en cours ou nécessite une vérification. Réessayez sans recréer votre commande.'); }
+}
+export async function withCommerceLock(base44, action, work) {
+  const control = base44.asServiceRole.entities.CommerceControl;
+  const owner = crypto.randomUUID();
+  const claim = await control.updateMany({ id: COMMERCE_CONTROL_ID, state: 'idle' }, {
+    $set: { state: 'running', owner, action, started_at: new Date().toISOString(), dirty: false, error: '' },
+  });
+  if (claim.updated !== 1) throw new CommerceBusyError();
+  let dirty = false;
+  const gate = {
+    async markDirty() {
+      if (dirty) return;
+      // Mark before the first write. A crash or ambiguous HTTP result never expires this lock.
+      dirty = true;
+      const result = await control.updateMany({ id: COMMERCE_CONTROL_ID, state: 'running', owner }, { $set: { dirty: true } });
+      if (result.updated !== 1) throw new Error('Commerce ownership lost');
+    },
+  };
+  async function release() {
+    const result = await control.updateMany({ id: COMMERCE_CONTROL_ID, state: 'running', owner }, {
+      $set: { state: 'idle', owner: '', action: '', dirty: false, error: '' },
+    });
+    if (result.updated !== 1) throw new Error('Commerce unlock failed');
+  }
+  try {
+    const result = await work(gate);
+    await release();
+    return result;
+  } catch (error) {
+    if (dirty) {
+      await control.updateMany({ id: COMMERCE_CONTROL_ID, state: 'running', owner }, {
+        $set: { state: 'review_required', error: 'Operation failed after writes began; reconcile before unlocking.' },
+      }).catch(() => null);
+    } else {
+      await release().catch(() => null);
+    }
+    throw error;
+  }
+}
