+async function moduleUrl(url) {
+  let source = await fs.readFile(url, 'utf8');
+  source = source.replace(/import \{ createClientFromRequest \} from ['"]npm:@base44\/sdk@[^'"]+['"];?/g, 'const createClientFromRequest = () => globalThis.__testBase44;');
+  for (const match of [...source.matchAll(/from ['"](\.\.?\/[^'"]+)['"]/g)]) {
+    source = source.replace(match[0], 'from ' + JSON.stringify(await moduleUrl(new URL(match[1], url))));
+  }
+  const { outputText } = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.ESNext, target: ts.ScriptTarget.ES2022 } });
+  return 'data:text/javascript;base64,' + Buffer.from(outputText).toString('base64');
+}
+const load = async path => import(await moduleUrl(new URL(path, import.meta.url)));
