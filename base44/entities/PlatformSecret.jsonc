{
  "type": "object",
  "name": "PlatformSecret",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting name (unique by convention, e.g. 'logistics', 'integrations')"
    },
    "value": {
      "type": "object",
      "description": "Confidential payload \u2014 never exposed to the storefront"
    },
    "note": {
      "type": "string",
      "description": "What this is for and who last changed it"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}