diff --git a/base44/functions/cancel-checkout-order/entry.ts b/base44/functions/cancel-checkout-order/entry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..aa90dfcfd25041d555cccffbf8692fe051bbbb0a
--- /dev/null
+++ b/base44/functions/cancel-checkout-order/entry.ts
@@ -0,0 +1,19 @@
+import { createClientFromRequest } from 'npm:@base44/sdk@0.8.54';
+import { cancelServerOrder, expireUnclaimedCheckouts } from '../../shared/checkoutCancellation.ts';
+import { CheckoutError } from '../../shared/checkoutService.ts';
+import { CommerceBusyError } from '../../shared/commerceLock.ts';
+export default async function(req) {
+  if (req.method !== 'POST') return Response.json({ error: 'Méthode interdite' }, { status: 405 });
+  try {
+    const base44 = createClientFromRequest(req);
+    const user = await base44.auth.me().catch(() => null);
+    const body = await req.json();
+    const result = body.action === 'expire' ? await expireUnclaimedCheckouts(base44, user) : await cancelServerOrder(base44, user, body);
+    if ("conflict" in result && result.conflict) return Response.json({ error: 'Commande modifiée pendant l’annulation.' }, { status: 409 });
+    return Response.json(result);
+  } catch (error) {
+    if (error instanceof CheckoutError || error instanceof CommerceBusyError) return Response.json({ error: error.message }, { status: error.status });
+    console.error('checkout cancellation failed', error);
+    return Response.json({ error: 'Annulation à vérifier avant de réessayer.' }, { status: 503 });
+  }
+}
