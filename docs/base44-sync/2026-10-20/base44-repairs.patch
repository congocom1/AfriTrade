+    get: async id => structuredClone(data[name].find(row => row.id === id)),
+    filter: async (query, sort, limit = 500, skip = 0) => structuredClone(data[name].filter(row =>
+      matches(row,query)).slice(skip,skip + limit)),
+    create: async input => {
+      if (failEntity === name) throw new Error('injected failure');
+      const row = { ...structuredClone(input), id: name + '-' + (data[name].length + 1), created_date: new Date().toISOString() };
+      data[name].push(row); writes.push([name,'create']); return structuredClone(row);
+    },
+    updateMany: async (query, operations) => {
+      if (failEntity === name) throw new Error('injected failure');
